# Root .gitignore for the repository
# Ignore node_modules in the frontend folder (ProyectoIFront)
/ProyectoIFront/node_modules/

# Also ignore node_modules if the frontend folder is named ProyectoFront (common naming variant)
/ProyectoFront/node_modules/

# Ignore environment files with sensitive credentials
ProyectoBD/ProyectoProgramado/app.env

# You can add other global ignores below as needed